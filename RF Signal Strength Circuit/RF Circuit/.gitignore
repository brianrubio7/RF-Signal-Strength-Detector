# --- Ignore everything by default ---
*

# --- But let git look inside folders so it can find allowed files ---
!*/

# --- Allow KiCad project & design files ---
!*.kicad_pro
!*.kicad_sch
!*.kicad_pcb
!*.kicad_prl
!*.kicad_dru
!*.kicad_wks
!*.kicad_mod
!*.kicad_sym

# --- Allow library tables (needed to resolve symbols/footprints) ---
!fp-lib-table
!sym-lib-table

# --- Allow this file and a README if you have one ---
!.gitignore
!README*
!readme*

# --- Explicitly re-ignore KiCad junk, even inside allowed folders ---
.history/
**/.history/
*.lck
**/*.lck
*-backups/
**/*-backups/
fp-info-cache
*-cache.lib
*.bak
*~
_autosave-*
